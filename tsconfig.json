{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "outDir": "dist",
        "rootDir": "webapi-gen",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "declaration": true,
        "resolveJsonModule": true
    },
    "include": [
        "webapi-gen/**/*"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "output"
    ]
}