// WebIDL Parser Grammar - Extended
// Based on the WebIDL grammar: https://webidl.spec.whatwg.org/#idl-grammar

%derive<Show> Token
%derive<Show> ParseError
%position<Int>
%start definitions

// Token declarations
%token EOF
%token<String> INTEGER
%token<String> FLOAT
%token<String> STRING
%token<String> IDENTIFIER

// Keywords - Definition
%token INTERFACE      "interface"
%token PARTIAL        "partial"
%token MIXIN          "mixin"
%token DICTIONARY     "dictionary"
%token ENUM           "enum"
%token TYPEDEF        "typedef"
%token CALLBACK       "callback"
%token NAMESPACE      "namespace"
%token INCLUDES       "includes"

// Keywords - Member
%token ATTRIBUTE      "attribute"
%token CONST          "const"
%token READONLY       "readonly"
%token INHERIT        "inherit"
%token STATIC         "static"
%token STRINGIFIER    "stringifier"
%token GETTER         "getter"
%token SETTER         "setter"
%token DELETER        "deleter"
%token CONSTRUCTOR    "constructor"
%token ITERABLE       "iterable"
%token ASYNC          "async"
%token MAPLIKE        "maplike"
%token SETLIKE        "setlike"
%token REQUIRED       "required"
%token OPTIONAL       "optional"

// Type keywords - Primitive
%token VOID           "void"
%token UNDEFINED      "undefined"
%token BOOLEAN        "boolean"
%token BYTE           "byte"
%token OCTET          "octet"
%token SHORT          "short"
%token LONG           "long"
%token UNSIGNED       "unsigned"
%token FLOAT_KW       "float"
%token DOUBLE         "double"
%token UNRESTRICTED   "unrestricted"
%token BIGINT         "bigint"

// Type keywords - String types
%token DOMSTRING      "DOMString"
%token BYTESTRING     "ByteString"
%token USVSTRING      "USVString"

// Type keywords - Special
%token ANY            "any"
%token OBJECT         "object"
%token SYMBOL         "symbol"

// Type keywords - Parameterized
%token SEQUENCE       "sequence"
%token PROMISE        "Promise"
%token FROZENARRAY    "FrozenArray"
%token OBSERVABLEARRAY "ObservableArray"
%token RECORD         "record"
%token OR             "or"

// Type keywords - Buffer types
%token ARRAYBUFFER         "ArrayBuffer"
%token SHAREDARRAYBUFFER   "SharedArrayBuffer"
%token DATAVIEW            "DataView"
%token INT8ARRAY           "Int8Array"
%token INT16ARRAY          "Int16Array"
%token INT32ARRAY          "Int32Array"
%token UINT8ARRAY          "Uint8Array"
%token UINT16ARRAY         "Uint16Array"
%token UINT32ARRAY         "Uint32Array"
%token UINT8CLAMPEDARRAY   "Uint8ClampedArray"
%token BIGINT64ARRAY       "BigInt64Array"
%token BIGUINT64ARRAY      "BigUint64Array"
%token FLOAT16ARRAY        "Float16Array"
%token FLOAT32ARRAY        "Float32Array"
%token FLOAT64ARRAY        "Float64Array"

// Literal keywords
%token TRUE           "true"
%token FALSE          "false"
%token NULL           "null"
%token INFINITY       "Infinity"
%token NEG_INFINITY   "-Infinity"
%token NAN            "NaN"

// Symbols
%token LBRACE         "{"
%token RBRACE         "}"
%token LPAREN         "("
%token RPAREN         ")"
%token LBRACKET       "["
%token RBRACKET       "]"
%token LANGLE         "<"
%token RANGLE         ">"
%token COMMA          ","
%token SEMICOLON      ";"
%token COLON          ":"
%token EQUALS         "="
%token QUESTION       "?"
%token ELLIPSIS       "..."
%token STAR           "*"

// Type declarations
%type<Array[Definition]> definitions
%type<Definition> definition
%type<InterfaceDefinition> interface_def
%type<PartialInterfaceDefinition> partial_interface_def
%type<MixinDefinition> mixin_def
%type<PartialMixinDefinition> partial_mixin_def
%type<NamespaceDefinition> namespace_def
%type<PartialNamespaceDefinition> partial_namespace_def
%type<DictionaryDefinition> dictionary_def
%type<PartialDictionaryDefinition> partial_dictionary_def
%type<EnumDefinition> enum_def
%type<TypedefDefinition> typedef_def
%type<CallbackInterfaceDefinition> callback_interface_def
%type<CallbackFunctionDefinition> callback_def
%type<IncludesStatement> includes_statement
%type<String?> inheritance
%type<Array[InterfaceMember]> interface_members
%type<InterfaceMember> interface_member
%type<Array[NamespaceMember]> namespace_members
%type<NamespaceMember> namespace_member
%type<ConstMember> const_member
%type<OperationMember> operation_member
%type<ConstructorMember> constructor_member
%type<IterableMember> iterable_member
%type<MaplikeMember> maplike_member
%type<SetlikeMember> setlike_member
%type<Array[DictionaryMember]> dictionary_members
%type<DictionaryMember> dictionary_member
%type<Array[String]> enum_value_list
%type<Array[String]> enum_value_list_rest
%type<Type> type
%type<Type> single_type
%type<Type> primitive_type
%type<Type> string_type
%type<Type> buffer_type
%type<Type?> null_modifier
%type<ConstValue> const_value
%type<DefaultValue?> default_value_opt
%type<DefaultValue> default_value
%type<Array[Argument]> argument_list
%type<Array[Argument]> arguments
%type<Argument> argument
%type<Bool> ellipsis
%type<Array[ExtendedAttribute]> extended_attribute_list
%type<Array[ExtendedAttribute]> extended_attributes
%type<ExtendedAttribute> extended_attribute
%type<Special> special

%%

definitions:
  | definition definitions          { [$1, ..$2] }
  | EOF                             { [] }

definition:
  | extended_attribute_list interface_def     { Definition::Interface({ ..$2, extended_attributes: $1 }) }
  | extended_attribute_list mixin_def         { Definition::Mixin({ ..$2, extended_attributes: $1 }) }
  | extended_attribute_list partial_interface_def { Definition::PartialInterface({ ..$2, extended_attributes: $1 }) }
  | extended_attribute_list partial_mixin_def { Definition::PartialMixin({ ..$2, extended_attributes: $1 }) }
  | extended_attribute_list namespace_def     { Definition::Namespace({ ..$2, extended_attributes: $1 }) }
  | extended_attribute_list partial_namespace_def { Definition::PartialNamespace({ ..$2, extended_attributes: $1 }) }
  | extended_attribute_list dictionary_def    { Definition::Dictionary({ ..$2, extended_attributes: $1 }) }
  | extended_attribute_list partial_dictionary_def { Definition::PartialDictionary({ ..$2, extended_attributes: $1 }) }
  | extended_attribute_list enum_def          { Definition::Enum_({ ..$2, extended_attributes: $1 }) }
  | extended_attribute_list typedef_def       { Definition::Typedef({ ..$2, extended_attributes: $1 }) }
  | extended_attribute_list callback_def      { Definition::CallbackFunction({ ..$2, extended_attributes: $1 }) }
  | extended_attribute_list callback_interface_def { Definition::CallbackInterface({ ..$2, extended_attributes: $1 }) }
  | extended_attribute_list includes_statement { Definition::Includes({ ..$2, extended_attributes: $1 }) }

interface_def:
  | "interface" IDENTIFIER inheritance "{" interface_members "}" ";"
      { { extended_attributes: [], name: $2, inheritance: $3, members: $5 } }

partial_interface_def:
  | "partial" "interface" IDENTIFIER "{" interface_members "}" ";"
      { { extended_attributes: [], name: $3, members: $5 } }

mixin_def:
  | "interface" "mixin" IDENTIFIER "{" interface_members "}" ";"
      { { extended_attributes: [], name: $3, members: $5 } }

partial_mixin_def:
  | "partial" "interface" "mixin" IDENTIFIER "{" interface_members "}" ";"
      { { extended_attributes: [], name: $4, members: $6 } }

namespace_def:
  | "namespace" IDENTIFIER "{" namespace_members "}" ";"
      { { extended_attributes: [], name: $2, members: $4 } }

partial_namespace_def:
  | "partial" "namespace" IDENTIFIER "{" namespace_members "}" ";"
      { { extended_attributes: [], name: $3, members: $5 } }

dictionary_def:
  | "dictionary" IDENTIFIER inheritance "{" dictionary_members "}" ";"
      { { extended_attributes: [], name: $2, inheritance: $3, members: $5 } }

partial_dictionary_def:
  | "partial" "dictionary" IDENTIFIER "{" dictionary_members "}" ";"
      { { extended_attributes: [], name: $3, members: $5 } }

enum_def:
  | "enum" IDENTIFIER "{" enum_value_list "}" ";"
      { { extended_attributes: [], name: $2, values: $4 } }

typedef_def:
  | "typedef" type IDENTIFIER ";"
      { { extended_attributes: [], type_: $2, name: $3 } }

callback_def:
  | "callback" IDENTIFIER "=" type "(" argument_list ")" ";"
      { { extended_attributes: [], name: $2, return_type: $4, arguments: $6 } }

callback_interface_def:
  | "callback" "interface" IDENTIFIER "{" interface_members "}" ";"
      { { extended_attributes: [], name: $3, members: $5 } }

includes_statement:
  | IDENTIFIER "includes" IDENTIFIER ";"
      { { extended_attributes: [], interface_name: $1, mixin_name: $3 } }

inheritance:
  | ":" IDENTIFIER              { Some($2) }
  |                             { None }

// Interface members
interface_members:
  | extended_attribute_list interface_member interface_members
      { [add_member_ext_attrs($2, $1), ..$3] }
  |                             { [] }

interface_member:
  | const_member                { InterfaceMember::Const($1) }
  | constructor_member          { InterfaceMember::Constructor($1) }
  | "stringifier" ";"           { InterfaceMember::Stringifier(StringifierMember::Bare) }
  | "static" "readonly" "attribute" type IDENTIFIER ";"
      { InterfaceMember::Attribute({ extended_attributes: [], type_: $4, name: $5, is_readonly: true, static_: true, is_inherit: false }) }
  | "static" "attribute" type IDENTIFIER ";"
      { InterfaceMember::Attribute({ extended_attributes: [], type_: $3, name: $4, is_readonly: false, static_: true, is_inherit: false }) }
  | "static" type IDENTIFIER "(" argument_list ")" ";"
      { InterfaceMember::Operation({ extended_attributes: [], return_type: $2, name: Some($3), arguments: $5, static_: true, special: None }) }
  | iterable_member             { InterfaceMember::Iterable($1) }
  | "async" "iterable" "<" type ">" ";"
      { InterfaceMember::AsyncIterable({ extended_attributes: [], key_type: None, value_type: $4, arguments: [] }) }
  | "async" "iterable" "<" type "," type ">" ";"
      { InterfaceMember::AsyncIterable({ extended_attributes: [], key_type: Some($4), value_type: $6, arguments: [] }) }
  | "readonly" maplike_member   { InterfaceMember::Maplike({ ..$2, is_readonly: true }) }
  | maplike_member              { InterfaceMember::Maplike($1) }
  | "readonly" setlike_member   { InterfaceMember::Setlike({ ..$2, is_readonly: true }) }
  | setlike_member              { InterfaceMember::Setlike($1) }
  | "inherit" "readonly" "attribute" type IDENTIFIER ";"
      { InterfaceMember::Attribute({ extended_attributes: [], type_: $4, name: $5, is_readonly: true, static_: false, is_inherit: true }) }
  | "inherit" "attribute" type IDENTIFIER ";"
      { InterfaceMember::Attribute({ extended_attributes: [], type_: $3, name: $4, is_readonly: false, static_: false, is_inherit: true }) }
  | "readonly" "attribute" type IDENTIFIER ";"
      { InterfaceMember::Attribute({ extended_attributes: [], type_: $3, name: $4, is_readonly: true, static_: false, is_inherit: false }) }
  | "attribute" type IDENTIFIER ";"
      { InterfaceMember::Attribute({ extended_attributes: [], type_: $2, name: $3, is_readonly: false, static_: false, is_inherit: false }) }
  | special type IDENTIFIER "(" argument_list ")" ";"
      { InterfaceMember::Operation({ extended_attributes: [], return_type: $2, name: Some($3), arguments: $5, static_: false, special: Some($1) }) }
  | special type "(" argument_list ")" ";"
      { InterfaceMember::Operation({ extended_attributes: [], return_type: $2, name: None, arguments: $4, static_: false, special: Some($1) }) }
  | operation_member            { InterfaceMember::Operation($1) }

// Namespace members
namespace_members:
  | extended_attribute_list namespace_member namespace_members
      { [add_namespace_member_ext_attrs($2, $1), ..$3] }
  |                             { [] }

namespace_member:
  | "readonly" "attribute" type IDENTIFIER ";"
      { NamespaceMember::Attribute({ extended_attributes: [], type_: $3, name: $4, is_readonly: true, static_: false, is_inherit: false }) }
  | type IDENTIFIER "(" argument_list ")" ";"
      { NamespaceMember::Operation({ extended_attributes: [], return_type: $1, name: Some($2), arguments: $4, static_: false, special: None }) }
  | const_member                { NamespaceMember::Const($1) }

const_member:
  | "const" type IDENTIFIER "=" const_value ";"
      { { extended_attributes: [], type_: $2, name: $3, value: $5 } }

operation_member:
  | type IDENTIFIER "(" argument_list ")" ";"
      { { extended_attributes: [], return_type: $1, name: Some($2), arguments: $4, static_: false, special: None } }
  | type "(" argument_list ")" ";"
      { { extended_attributes: [], return_type: $1, name: None, arguments: $3, static_: false, special: None } }

special:
  | "getter"                    { Special::Getter }
  | "setter"                    { Special::Setter }
  | "deleter"                   { Special::Deleter }

constructor_member:
  | "constructor" "(" argument_list ")" ";"
      { { extended_attributes: [], arguments: $3 } }

iterable_member:
  | "iterable" "<" type ">" ";"
      { { extended_attributes: [], key_type: None, value_type: $3 } }
  | "iterable" "<" type "," type ">" ";"
      { { extended_attributes: [], key_type: Some($3), value_type: $5 } }

maplike_member:
  | "maplike" "<" type "," type ">" ";"
      { { extended_attributes: [], key_type: $3, value_type: $5, is_readonly: false } }

setlike_member:
  | "setlike" "<" type ">" ";"
      { { extended_attributes: [], value_type: $3, is_readonly: false } }

// Dictionary members
dictionary_members:
  | extended_attribute_list dictionary_member dictionary_members
      { [{ ..$2, extended_attributes: $1 }, ..$3] }
  |                             { [] }

dictionary_member:
  | "required" type IDENTIFIER ";"
      { { extended_attributes: [], type_: $2, name: $3, required: true, default_value: None } }
  | type IDENTIFIER default_value_opt ";"
      { { extended_attributes: [], type_: $1, name: $2, required: false, default_value: $3 } }

// Enum values
enum_value_list:
  | STRING enum_value_list_rest { [$1, ..$2] }

enum_value_list_rest:
  | "," STRING enum_value_list_rest  { [$2, ..$3] }
  | ","                              { [] }
  |                                  { [] }

// Types
type:
  | single_type null_modifier   { 
      match $2 {
        Some(_) => Type::Nullable($1)
        None => $1 
      }
    }
  | "(" single_type "or" single_type ")" null_modifier {
      let union = Type::Union([$2, $4])
      match $6 {
        Some(_) => Type::Nullable(union)
        None => union
      }
    }

single_type:
  | primitive_type              { $1 }
  | string_type                 { $1 }
  | buffer_type                 { $1 }
  | IDENTIFIER                  { Type::Identifier($1) }
  | "sequence" "<" type ">"     { Type::Sequence($3) }
  | "Promise" "<" type ">"      { Type::Promise($3) }
  | "FrozenArray" "<" type ">"  { Type::FrozenArray($3) }
  | "ObservableArray" "<" type ">" { Type::ObservableArray($3) }
  | "record" "<" string_type "," type ">" { Type::Record(type_to_string_type($3), $5) }
  | "any"                       { Type::Any }
  | "object"                    { Type::Object }
  | "symbol"                    { Type::Symbol }
  | "undefined"                 { Type::Undefined }
  | "void"                      { Type::Void }

primitive_type:
  | "boolean"                   { Type::Boolean }
  | "byte"                      { Type::Byte }
  | "octet"                     { Type::Octet }
  | "short"                     { Type::Short }
  | "unsigned" "short"          { Type::UnsignedShort }
  | "long"                      { Type::Long }
  | "unsigned" "long"           { Type::UnsignedLong }
  | "long" "long"               { Type::LongLong }
  | "unsigned" "long" "long"    { Type::UnsignedLongLong }
  | "float"                     { Type::Float }
  | "unrestricted" "float"      { Type::UnrestrictedFloat }
  | "double"                    { Type::Double }
  | "unrestricted" "double"     { Type::UnrestrictedDouble }
  | "bigint"                    { Type::Bigint }

string_type:
  | "DOMString"                 { Type::DOMString }
  | "ByteString"                { Type::ByteString }
  | "USVString"                 { Type::USVString }

buffer_type:
  | "ArrayBuffer"               { Type::Identifier("ArrayBuffer") }
  | "SharedArrayBuffer"         { Type::Identifier("SharedArrayBuffer") }
  | "DataView"                  { Type::Identifier("DataView") }
  | "Int8Array"                 { Type::Identifier("Int8Array") }
  | "Int16Array"                { Type::Identifier("Int16Array") }
  | "Int32Array"                { Type::Identifier("Int32Array") }
  | "Uint8Array"                { Type::Identifier("Uint8Array") }
  | "Uint16Array"               { Type::Identifier("Uint16Array") }
  | "Uint32Array"               { Type::Identifier("Uint32Array") }
  | "Uint8ClampedArray"         { Type::Identifier("Uint8ClampedArray") }
  | "BigInt64Array"             { Type::Identifier("BigInt64Array") }
  | "BigUint64Array"            { Type::Identifier("BigUint64Array") }
  | "Float16Array"              { Type::Identifier("Float16Array") }
  | "Float32Array"              { Type::Identifier("Float32Array") }
  | "Float64Array"              { Type::Identifier("Float64Array") }

null_modifier:
  | "?"                         { Some(Type::Void) }
  |                             { None }

// Const values
const_value:
  | "true"                      { ConstValue::Boolean(true) }
  | "false"                     { ConstValue::Boolean(false) }
  | INTEGER                     { ConstValue::Integer($1) }
  | FLOAT                       { ConstValue::Float($1) }
  | "Infinity"                  { ConstValue::Infinity }
  | "-Infinity"                 { ConstValue::NegInfinity }
  | "NaN"                       { ConstValue::NaN }

// Default values
default_value_opt:
  | "=" default_value           { Some($2) }
  |                             { None }

default_value:
  | const_value                 { DefaultValue::ConstValue($1) }
  | STRING                      { DefaultValue::String($1) }
  | "[" "]"                     { DefaultValue::EmptySequence }
  | "{" "}"                     { DefaultValue::EmptyObject }
  | "null"                      { DefaultValue::Null }
  | "undefined"                 { DefaultValue::Undefined }

// Arguments
argument_list:
  | argument arguments          { [$1, ..$2] }
  |                             { [] }

arguments:
  | "," argument arguments      { [$2, ..$3] }
  |                             { [] }

argument:
  | extended_attribute_list "optional" type IDENTIFIER default_value_opt
      { { extended_attributes: $1, type_: $3, name: $4, optional: true, variadic: false, default_value: $5 } }
  | extended_attribute_list type ellipsis IDENTIFIER
      { { extended_attributes: $1, type_: $2, name: $4, optional: false, variadic: $3, default_value: None } }

ellipsis:
  | "..."                       { true }
  |                             { false }

// Extended attributes
extended_attribute_list:
  | "[" extended_attribute extended_attributes "]"  { [$2, ..$3] }
  |                             { [] }

extended_attributes:
  | "," extended_attribute extended_attributes  { [$2, ..$3] }
  |                             { [] }

extended_attribute:
  | IDENTIFIER "=" IDENTIFIER "(" argument_list ")" { ExtendedAttribute::NamedArgList($1, $3, $5) }
  | IDENTIFIER "=" IDENTIFIER   { ExtendedAttribute::Ident($1, $3) }
  | IDENTIFIER "=" STRING       { ExtendedAttribute::Ident($1, $3) }
  | IDENTIFIER "=" "*"          { ExtendedAttribute::Wildcard($1) }
  | IDENTIFIER "(" argument_list ")"  { ExtendedAttribute::ArgList($1, $3) }
  | IDENTIFIER                  { ExtendedAttribute::NoArgs($1) }

%%

// Helper functions

fn add_member_ext_attrs(m : InterfaceMember, attrs : Array[ExtendedAttribute]) -> InterfaceMember {
  match m {
    InterfaceMember::Const(c) => InterfaceMember::Const({ ..c, extended_attributes: attrs })
    InterfaceMember::Attribute(a) => InterfaceMember::Attribute({ ..a, extended_attributes: attrs })
    InterfaceMember::Operation(o) => InterfaceMember::Operation({ ..o, extended_attributes: attrs })
    InterfaceMember::Constructor(c) => InterfaceMember::Constructor({ ..c, extended_attributes: attrs })
    InterfaceMember::Iterable(i) => InterfaceMember::Iterable({ ..i, extended_attributes: attrs })
    InterfaceMember::AsyncIterable(a) => InterfaceMember::AsyncIterable({ ..a, extended_attributes: attrs })
    InterfaceMember::Maplike(ml) => InterfaceMember::Maplike({ ..ml, extended_attributes: attrs })
    InterfaceMember::Setlike(s) => InterfaceMember::Setlike({ ..s, extended_attributes: attrs })
    InterfaceMember::Stringifier(s) => InterfaceMember::Stringifier(s)
  }
}

fn add_namespace_member_ext_attrs(m : NamespaceMember, attrs : Array[ExtendedAttribute]) -> NamespaceMember {
  match m {
    NamespaceMember::Attribute(a) => NamespaceMember::Attribute({ ..a, extended_attributes: attrs })
    NamespaceMember::Operation(o) => NamespaceMember::Operation({ ..o, extended_attributes: attrs })
    NamespaceMember::Const(c) => NamespaceMember::Const({ ..c, extended_attributes: attrs })
  }
}

fn type_to_string_type(t : Type) -> StringType {
  match t {
    Type::DOMString => StringType::DOMString
    Type::ByteString => StringType::ByteString
    Type::USVString => StringType::USVString
    _ => StringType::DOMString
  }
}
