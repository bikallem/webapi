{
    "name": "mbt-dom-gen",
    "version": "0.1.0",
    "description": "Generate MoonBit DOM bindings from Web IDL",
    "type": "module",
    "main": "dist/build.js",
    "scripts": {
        "build": "tsc",
        "generate": "tsc && node dist/build.js",
        "clean": "rm -rf dist webapi/dom/*.mbt webapi/dom/*.mjs"
    },
    "keywords": [
        "moonbit",
        "dom",
        "webidl",
        "codegen",
        "ffi"
    ],
    "author": "",
    "license": "MIT",
    "dependencies": {
        "@webref/events": "^1.19.1",
        "@webref/idl": "^3.49.0",
        "webidl2": "^24.4.1"
    },
    "devDependencies": {
        "@types/node": "^20.10.0",
        "@types/webidl2": "^24.4.3",
        "prettier": "^3.1.0",
        "terser": "^5.44.1",
        "typescript": "^5.3.0"
    }
}