pub(all) enum Token {
  EOF
  INTEGER(String)
  FLOAT(String)
  STRING(String)
  IDENTIFIER(String)
  INTERFACE
  PARTIAL
  MIXIN
  DICTIONARY
  ENUM
  TYPEDEF
  CALLBACK
  NAMESPACE
  INCLUDES
  ATTRIBUTE
  CONST
  READONLY
  INHERIT
  STATIC
  STRINGIFIER
  GETTER
  SETTER
  DELETER
  CONSTRUCTOR
  ITERABLE
  ASYNC_ITERABLE
  ASYNC_SEQUENCE
  MAPLIKE
  SETLIKE
  REQUIRED
  OPTIONAL
  VOID
  UNDEFINED
  BOOLEAN
  BYTE
  OCTET
  SHORT
  LONG
  UNSIGNED
  FLOAT_KW
  DOUBLE
  UNRESTRICTED
  BIGINT
  DOMSTRING
  BYTESTRING
  USVSTRING
  ANY
  OBJECT
  SYMBOL
  SEQUENCE
  PROMISE
  FROZENARRAY
  OBSERVABLEARRAY
  RECORD
  OR
  ARRAYBUFFER
  SHAREDARRAYBUFFER
  DATAVIEW
  INT8ARRAY
  INT16ARRAY
  INT32ARRAY
  UINT8ARRAY
  UINT16ARRAY
  UINT32ARRAY
  UINT8CLAMPEDARRAY
  BIGINT64ARRAY
  BIGUINT64ARRAY
  FLOAT16ARRAY
  FLOAT32ARRAY
  FLOAT64ARRAY
  TRUE
  FALSE
  NULL
  INFINITY
  NEG_INFINITY
  NAN
  LBRACE
  RBRACE
  LPAREN
  RPAREN
  LBRACKET
  RBRACKET
  LANGLE
  RANGLE
  COMMA
  SEMICOLON
  COLON
  EQUALS
  QUESTION
  ELLIPSIS
  STAR
} derive(Show, ToJson)

pub fn Token::kind(self : Token) -> TokenKind {
  match self {
    EOF => TK_EOF
    INTEGER(_) => TK_INTEGER
    FLOAT(_) => TK_FLOAT
    STRING(_) => TK_STRING
    IDENTIFIER(_) => TK_IDENTIFIER
    INTERFACE => TK_INTERFACE
    PARTIAL => TK_PARTIAL
    MIXIN => TK_MIXIN
    DICTIONARY => TK_DICTIONARY
    ENUM => TK_ENUM
    TYPEDEF => TK_TYPEDEF
    CALLBACK => TK_CALLBACK
    NAMESPACE => TK_NAMESPACE
    INCLUDES => TK_INCLUDES
    ATTRIBUTE => TK_ATTRIBUTE
    CONST => TK_CONST
    READONLY => TK_READONLY
    INHERIT => TK_INHERIT
    STATIC => TK_STATIC
    STRINGIFIER => TK_STRINGIFIER
    GETTER => TK_GETTER
    SETTER => TK_SETTER
    DELETER => TK_DELETER
    CONSTRUCTOR => TK_CONSTRUCTOR
    ITERABLE => TK_ITERABLE
    ASYNC_ITERABLE => TK_ASYNC_ITERABLE
    ASYNC_SEQUENCE => TK_ASYNC_SEQUENCE
    MAPLIKE => TK_MAPLIKE
    SETLIKE => TK_SETLIKE
    REQUIRED => TK_REQUIRED
    OPTIONAL => TK_OPTIONAL
    VOID => TK_VOID
    UNDEFINED => TK_UNDEFINED
    BOOLEAN => TK_BOOLEAN
    BYTE => TK_BYTE
    OCTET => TK_OCTET
    SHORT => TK_SHORT
    LONG => TK_LONG
    UNSIGNED => TK_UNSIGNED
    FLOAT_KW => TK_FLOAT_KW
    DOUBLE => TK_DOUBLE
    UNRESTRICTED => TK_UNRESTRICTED
    BIGINT => TK_BIGINT
    DOMSTRING => TK_DOMSTRING
    BYTESTRING => TK_BYTESTRING
    USVSTRING => TK_USVSTRING
    ANY => TK_ANY
    OBJECT => TK_OBJECT
    SYMBOL => TK_SYMBOL
    SEQUENCE => TK_SEQUENCE
    PROMISE => TK_PROMISE
    FROZENARRAY => TK_FROZENARRAY
    OBSERVABLEARRAY => TK_OBSERVABLEARRAY
    RECORD => TK_RECORD
    OR => TK_OR
    ARRAYBUFFER => TK_ARRAYBUFFER
    SHAREDARRAYBUFFER => TK_SHAREDARRAYBUFFER
    DATAVIEW => TK_DATAVIEW
    INT8ARRAY => TK_INT8ARRAY
    INT16ARRAY => TK_INT16ARRAY
    INT32ARRAY => TK_INT32ARRAY
    UINT8ARRAY => TK_UINT8ARRAY
    UINT16ARRAY => TK_UINT16ARRAY
    UINT32ARRAY => TK_UINT32ARRAY
    UINT8CLAMPEDARRAY => TK_UINT8CLAMPEDARRAY
    BIGINT64ARRAY => TK_BIGINT64ARRAY
    BIGUINT64ARRAY => TK_BIGUINT64ARRAY
    FLOAT16ARRAY => TK_FLOAT16ARRAY
    FLOAT32ARRAY => TK_FLOAT32ARRAY
    FLOAT64ARRAY => TK_FLOAT64ARRAY
    TRUE => TK_TRUE
    FALSE => TK_FALSE
    NULL => TK_NULL
    INFINITY => TK_INFINITY
    NEG_INFINITY => TK_NEG_INFINITY
    NAN => TK_NAN
    LBRACE => TK_LBRACE
    RBRACE => TK_RBRACE
    LPAREN => TK_LPAREN
    RPAREN => TK_RPAREN
    LBRACKET => TK_LBRACKET
    RBRACKET => TK_RBRACKET
    LANGLE => TK_LANGLE
    RANGLE => TK_RANGLE
    COMMA => TK_COMMA
    SEMICOLON => TK_SEMICOLON
    COLON => TK_COLON
    EQUALS => TK_EQUALS
    QUESTION => TK_QUESTION
    ELLIPSIS => TK_ELLIPSIS
    STAR => TK_STAR
  }
}

