// WebIDL Parser Grammar - Extended
// Based on the WebIDL grammar: https://webidl.spec.whatwg.org/#idl-grammar

%derive<Show,ToJson> Token
%derive<Show> ParseError
%position<Position>
%start definitions

// Token declarations
%token EOF
%token<String> INTEGER
%token<String> FLOAT
%token<String> STRING
%token<String> IDENTIFIER

// Keywords - Definition
%token INTERFACE      "interface"
%token PARTIAL        "partial"
%token MIXIN          "mixin"
%token DICTIONARY     "dictionary"
%token ENUM           "enum"
%token TYPEDEF        "typedef"
%token CALLBACK       "callback"
%token NAMESPACE      "namespace"
%token INCLUDES       "includes"

// Keywords - Member
%token ATTRIBUTE      "attribute"
%token CONST          "const"
%token READONLY       "readonly"
%token INHERIT        "inherit"
%token STATIC         "static"
%token STRINGIFIER    "stringifier"
%token GETTER         "getter"
%token SETTER         "setter"
%token DELETER        "deleter"
%token CONSTRUCTOR    "constructor"
%token ITERABLE       "iterable"
%token ASYNC_ITERABLE "async_iterable"
%token ASYNC_SEQUENCE  "async_sequence"
%token MAPLIKE        "maplike"
%token SETLIKE        "setlike"
%token REQUIRED       "required"
%token OPTIONAL       "optional"

// Type keywords - Primitive
%token UNDEFINED      "undefined"
%token BOOLEAN        "boolean"
%token BYTE           "byte"
%token OCTET          "octet"
%token SHORT          "short"
%token LONG           "long"
%token UNSIGNED       "unsigned"
%token FLOAT_KW       "float"
%token DOUBLE         "double"
%token UNRESTRICTED   "unrestricted"
%token BIGINT         "bigint"

// Type keywords - String types
%token DOMSTRING      "DOMString"
%token BYTESTRING     "ByteString"
%token USVSTRING      "USVString"

// Type keywords - Special
%token ANY            "any"
%token OBJECT         "object"
%token SYMBOL         "symbol"

// Type keywords - Parameterized
%token SEQUENCE       "sequence"
%token PROMISE        "Promise"
%token FROZENARRAY    "FrozenArray"
%token OBSERVABLEARRAY "ObservableArray"
%token RECORD         "record"

// Operators
%token OR             "or"

// Type keywords - Buffer types
%token ARRAYBUFFER         "ArrayBuffer"
%token SHAREDARRAYBUFFER   "SharedArrayBuffer"
%token DATAVIEW            "DataView"
%token INT8ARRAY           "Int8Array"
%token INT16ARRAY          "Int16Array"
%token INT32ARRAY          "Int32Array"
%token UINT8ARRAY          "Uint8Array"
%token UINT16ARRAY         "Uint16Array"
%token UINT32ARRAY         "Uint32Array"
%token UINT8CLAMPEDARRAY   "Uint8ClampedArray"
%token BIGINT64ARRAY       "BigInt64Array"
%token BIGUINT64ARRAY      "BigUint64Array"
%token FLOAT16ARRAY        "Float16Array"
%token FLOAT32ARRAY        "Float32Array"
%token FLOAT64ARRAY        "Float64Array"

// Literal keywords
%token TRUE           "true"
%token FALSE          "false"
%token NULL           "null"
%token INFINITY       "Infinity"
%token NEG_INFINITY   "-Infinity"
%token NAN            "NaN"

// Symbols
%token LBRACE         "{"
%token RBRACE         "}"
%token LPAREN         "("
%token RPAREN         ")"
%token LBRACKET       "["
%token RBRACKET       "]"
%token LANGLE         "<"
%token RANGLE         ">"
%token COMMA          ","
%token SEMICOLON      ";"
%token COLON          ":"
%token EQUALS         "="
%token QUESTION       "?"
%token ELLIPSIS       "..."
%token STAR           "*"

%%

definitions -> Array[Definition]:
  | ext_attr = extended_attribute_list def=definition defs = definitions  { [add_definition_ext_attrs(def, ext_attr), ..defs] }
  | EOF                                             { [] }

definition -> Definition:
  | interface_def               { Definition::Interface($1) }
  | mixin_def                   { Definition::Mixin($1) }
  | partial_interface_def       { Definition::PartialInterface($1) }
  | partial_mixin_def           { Definition::PartialMixin($1) }
  | namespace_def               { Definition::Namespace($1) }
  | partial_namespace_def       { Definition::PartialNamespace($1) }
  | dictionary_def              { Definition::Dictionary($1) }
  | partial_dictionary_def      { Definition::PartialDictionary($1) }
  | enum_def                    { Definition::Enum($1) }
  | typedef_def                 { Definition::Typedef($1) }
  | callback_def                { Definition::CallbackFunction($1) }
  | callback_interface_def      { Definition::CallbackInterface($1) }
  | includes_statement          { Definition::Includes($1) }

interface_def -> InterfaceDefinition:
  | "interface" name=IDENTIFIER inheritance = inheritance "{" members = interface_members "}" ";"
      { { extended_attributes: [], name, inheritance, members } }

partial_interface_def -> PartialInterfaceDefinition:
  | "partial" "interface" name=IDENTIFIER "{" members = interface_members "}" ";"  
      { { extended_attributes: [], name, members } }

mixin_def -> MixinDefinition:
  | "interface" "mixin" name=IDENTIFIER "{" members = interface_members "}" ";"
      { { extended_attributes: [], name, members } }

partial_mixin_def -> PartialMixinDefinition:
  | "partial" "interface" "mixin" name=IDENTIFIER "{" members = interface_members "}" ";"
      { { extended_attributes: [], name, members } }

namespace_def -> NamespaceDefinition:
  | "namespace" name=IDENTIFIER "{" members = namespace_members "}" ";"
      { { extended_attributes: [], name, members } }

partial_namespace_def -> PartialNamespaceDefinition:
  | "partial" "namespace" name=IDENTIFIER "{" members = namespace_members "}" ";"
      { { extended_attributes: [], name, members } }

dictionary_def -> DictionaryDefinition:
  | "dictionary" name=IDENTIFIER inheritance = inheritance "{" members = dictionary_members "}" ";"
      { { extended_attributes: [], name, inheritance, members } }

partial_dictionary_def -> PartialDictionaryDefinition:
  | "partial" "dictionary" name=IDENTIFIER "{" members = dictionary_members "}" ";"
      { { extended_attributes: [], name, members } }

enum_def -> EnumDefinition:
  | "enum" name=IDENTIFIER "{" values = enum_value_list "}" ";"
      { { extended_attributes: [], name, values } }
      
typedef_def -> TypedefDefinition:
  | "typedef" type_=type name=IDENTIFIER ";"
      { { extended_attributes: [], type_, name } }

callback_def -> CallbackFunctionDefinition:
  | "callback" name=IDENTIFIER "=" return_type=type "(" arguments=argument_list ")" ";"
      { { extended_attributes: [], name, return_type, arguments } }

callback_interface_def -> CallbackInterfaceDefinition:
  | "callback" "interface" name=IDENTIFIER "{" members = callback_interface_members "}" ";"
      { { extended_attributes: [], name, members } }

callback_interface_members -> Array[CallbackInterfaceMember]:
  | ext_attr=extended_attribute_list m=callback_interface_member members=callback_interface_members
      { [add_callback_interface_member_ext_attrs(m, ext_attr), ..members] }
  |   { [] }

callback_interface_member -> CallbackInterfaceMember:
  | op=operation_member           { CallbackInterfaceMember::Operation(op) }
  | c=const_member                { CallbackInterfaceMember::Const(c) }

includes_statement -> IncludesStatement:
  | interface_name=IDENTIFIER "includes" mixin_name=IDENTIFIER ";"
      { { extended_attributes: [], interface_name, mixin_name } }

inheritance -> String?:
  | ":" name=IDENTIFIER         { Some(name) }
  |                             { None }

// Interface members
interface_members -> Array[InterfaceMember]:
  | ext_attr=extended_attribute_list m=interface_member members=interface_members
      { [add_interface_member_ext_attrs(m, ext_attr), ..members] }
  |   { [] }

interface_member -> InterfaceMember:
  | c=const_member                { Const(c) }
  | cm=constructor_member         { Constructor(cm) }
  | "stringifier" ";"             { Stringifier(StringifierMember::Bare) }
  | "static" "readonly" "attribute" type_=type name=IDENTIFIER ";"
      { Attribute({ extended_attributes: [], type_: type_, name, is_readonly: true, static_: true, is_inherit: false }) }
  | "static" "attribute" type_=type name=IDENTIFIER ";"
      { Attribute({ extended_attributes: [], type_: type_, name, is_readonly: false, static_: true, is_inherit: false }) }
  | "static" type_=type name=IDENTIFIER "(" arguments=argument_list ")" ";"
      { Operation({ extended_attributes: [], return_type: type_, name: Some(name), arguments, static_: true, special: None }) }
  | i=iterable_member             { Iterable(i) }
  | "async_iterable" "<" type ">" ";"
      { AsyncIterable({ extended_attributes: [], key_type: None, value_type: $3, arguments: [] }) }
  | "async_iterable" "<" type "," type ">" ";"
      { AsyncIterable({ extended_attributes: [], key_type: Some($3), value_type: $5, arguments: [] }) }
  | "readonly" m=maplike_member   { Maplike({ ..m, is_readonly: true }) }
  | m=maplike_member              { Maplike(m) }
  | "readonly" s=setlike_member   { Setlike({ ..s, is_readonly: true }) }
  | s=setlike_member              { Setlike(s) }
  | "inherit" "readonly" "attribute" type_=type name=IDENTIFIER ";"
      { Attribute({ extended_attributes: [], type_, name, is_readonly: true, static_: false, is_inherit: true }) }
  | "inherit" "attribute" type_=type name=IDENTIFIER ";"
      { Attribute({ extended_attributes: [], type_, name, is_readonly: false, static_: false, is_inherit: true }) }
  | "readonly" "attribute" type_=type name=IDENTIFIER ";"
      { Attribute({ extended_attributes: [], type_, name, is_readonly: true, static_: false, is_inherit: false }) }
  | "attribute" type_=type name=IDENTIFIER ";"
      { Attribute({ extended_attributes: [], type_, name, is_readonly: false, static_: false, is_inherit: false }) }
  | sp=special type_=type name=IDENTIFIER "(" arguments=argument_list ")" ";"
      { Operation({ extended_attributes: [], return_type: type_, name: Some(name), arguments: arguments, static_: false, special: Some(sp) }) }
  | sp=special type_=type "(" arguments=argument_list ")" ";"
      { Operation({ extended_attributes: [], return_type: type_, name: None, arguments: arguments, static_: false, special: Some(sp) }) }
  | op=operation_member            { Operation(op) }

// Namespace members
namespace_members -> Array[NamespaceMember]:
  | extended_attribute_list namespace_member namespace_members
      { [add_namespace_member_ext_attrs($2, $1), ..$3] }
  |                             { [] }

namespace_member -> NamespaceMember:
  | "readonly" "attribute" type IDENTIFIER ";"
      { NamespaceMember::Attribute({ extended_attributes: [], type_: $3, name: $4, is_readonly: true, static_: false, is_inherit: false }) }
  | type IDENTIFIER "(" argument_list ")" ";"
      { NamespaceMember::Operation({ extended_attributes: [], return_type: $1, name: Some($2), arguments: $4, static_: false, special: None }) }
  | const_member                { NamespaceMember::Const($1) }

const_member -> ConstMember:
  | "const" type IDENTIFIER "=" const_value ";"
      { { extended_attributes: [], type_: $2, name: $3, value: $5 } }

operation_member -> OperationMember:
  | type IDENTIFIER "(" argument_list ")" ";"
      { { extended_attributes: [], return_type: $1, name: Some($2), arguments: $4, static_: false, special: None } }
  | type "(" argument_list ")" ";"
      { { extended_attributes: [], return_type: $1, name: None, arguments: $3, static_: false, special: None } }

special -> Special:
  | "getter"                    { Special::Getter }
  | "setter"                    { Special::Setter }
  | "deleter"                   { Special::Deleter }

constructor_member -> ConstructorMember:
  | "constructor" "(" argument_list ")" ";"
      { { extended_attributes: [], arguments: $3 } }

iterable_member -> IterableMember:
  | "iterable" "<" type ">" ";"
      { { extended_attributes: [], key_type: None, value_type: $3 } }
  | "iterable" "<" type "," type ">" ";"
      { { extended_attributes: [], key_type: Some($3), value_type: $5 } }

maplike_member -> MaplikeMember:
  | "maplike" "<" type "," type ">" ";"
      { { extended_attributes: [], key_type: $3, value_type: $5, is_readonly: false } }

setlike_member -> SetlikeMember:
  | "setlike" "<" type ">" ";"
      { { extended_attributes: [], value_type: $3, is_readonly: false } }

// Dictionary members
dictionary_members -> Array[DictionaryMember]:
  | extended_attributes=extended_attribute_list m=dictionary_member members=dictionary_members
      { [{ ..m, extended_attributes }, ..members] }
  |                             { [] }

dictionary_member -> DictionaryMember:
  | "required" type_=type name=IDENTIFIER ";"
      { { extended_attributes: [], type_, name, required: true, default_value: None } }
  | type_=type name=IDENTIFIER default_value=default_value_opt ";"
      { { extended_attributes: [], type_, name, required: false, default_value } }

// Enum values
enum_value_list -> Array[String]:
  | e=STRING enums=enum_value_list_rest { [e, ..enums] }

enum_value_list_rest -> Array[String]:
  | "," e=STRING enums=enum_value_list_rest  { [e, ..enums] }
  | ","                              { [] }
  |                                  { [] }

// Arguments
argument_list -> Array[Argument]:
  | argument arguments          { [$1, ..$2] }
  |                             { [] }

arguments -> Array[Argument]:
  | "," argument arguments      { [$2, ..$3] }
  |                             { [] }

argument -> Argument:
  | extended_attributes=extended_attribute_list arg=argument_rest
      { { ..arg, extended_attributes } }

argument_rest -> Argument:
  | "optional" type_=type_with_extended_attributes name=argument_name default_value=default_value_opt
      { { extended_attributes:[], type_, name, optional: true, variadic: false, default_value } }
  | type_=type variadic=ellipsis  name=argument_name
      { 
        let type_ = { extended_attributes: [], type_ }
        { extended_attributes:[], type_, name, optional: false, variadic, default_value: None } 
      }

ellipsis -> Bool:
  | "..."                       { true }
  |                             { false }

argument_name -> String:
  | argument_name_keyword   { $1 }
  | IDENTIFIER              { $1 }

argument_name_keyword -> String
  : "attribute"    { "attribute" }
  | "callback"     { "callback" }
  | "const"        { "const" }
  | "constructor"  { "constructor" }
  | "deleter"      { "deleter" }
  | "dictionary"   { "dictionary" }
  | "enum"         { "enum" }
  | "getter"       { "getter" }
  | "includes"     { "includes" }
  | "inherit"      { "inherit" }
  | "interface"    { "interface" }
  | "iterable"     { "iterable" }
  | "maplike"      { "maplike" }
  | "mixin"        { "mixin" }
  | "namespace"    { "namespace" }
  | "partial"      { "partial" }
  | "readonly"     { "readonly" }
  | "required"     { "required" }
  | "setlike"      { "setlike" }
  | "setter"       { "setter" }
  | "static"       { "static" }
  | "stringifier"  { "stringifier" }
  | "typedef"      { "typedef" }
  | "unrestricted" { "unrestricted" }
  ;

type -> Type:
  | type_=single_type { type_ }
  | union_type=union_type { union_type }

type_with_extended_attributes -> TypeWithExtendedAttributes:
  | extended_attributes=extended_attribute_list type_=type  { { extended_attributes, type_ } }

// Union types
union_type -> Type:
  | "(" union_member_type "or" union_member_type union_member_types ")"      { Type::Union([$2, $4, ..$5]) }

union_member_type -> TypeWithExtendedAttributes:
  | extended_attributes = extended_attribute_list type_=distinguishable_type
    { {extended_attributes, type_} }
  | union_type=union_type is_null=null_modifier
    {
      let ty = match is_null {
        true => Type::Nullable(union_type)
        false => union_type
      }
      { extended_attributes: [], type_: ty }
    }

union_member_types -> Array[TypeWithExtendedAttributes]:
  | "or" union_member_type union_member_types   { [$2, ..$3] }
  |                                             { [] }

distinguishable_type -> Type:
  | primitive_type                { $1 }
  | string_type                   { $1 }
  | IDENTIFIER                    { Type::Identifier($1) }
  | "sequence" "<" type ">"       { Type::Sequence($3) }
  | "async_sequence" "<" type_with_extended_attributes ">" 
    { Type::AsyncSequence($3) }
  | "object"                    { Type::Object }
  | "symbol"                    { Type::Symbol }
  | buffer_type                 { $1 }
  | "FrozenArray" "<" type_with_extended_attributes ">"
    { Type::FrozenArray($3) }
  | "ObservableArray" "<" type_with_extended_attributes ">"
    { Type::ObservableArray($3) }
  | "record" "<" string_type "," type_with_extended_attributes ">" 
    { Type::Record(type_to_string_type($3), $5) }
  | "undefined"                 { Type::Undefined }

single_type -> Type:
  | type_=distinguishable_type is_null=null_modifier
    { 
      if is_null {
        Type::Nullable(type_)
      } else {
        type_
      }
    }
  | "any"                       { Type::Any }
  | "Promise" "<" type ">"      { Type::Promise($3) }

primitive_type -> Type:
  // Unsigned integer types
  | "unsigned" "short"          { Type::UnsignedShort }
  | "unsigned" "long" "long"    { Type::UnsignedLongLong }
  | "unsigned" "long"           { Type::UnsignedLong }
  
  // Signed integer types
  | "short"                     { Type::Short }  
  | "long"                      { Type::Long }
  | "long" "long"               { Type::LongLong }  
  
  // Unrestricted float types
  | "unrestricted" "float"      { Type::UnrestrictedFloat }
  | "unrestricted" "double"     { Type::UnrestrictedDouble }
  
  // Float types
  | "float"                     { Type::Float }  
  | "double"                    { Type::Double }

  // Other primitive types
  | "boolean"                   { Type::Boolean }
  | "byte"                      { Type::Byte }
  | "octet"                     { Type::Octet }
  | "bigint"                    { Type::Bigint }

string_type -> Type:
  | "DOMString"                 { Type::DOMString }
  | "ByteString"                { Type::ByteString }
  | "USVString"                 { Type::USVString }

buffer_type -> Type:
  | "ArrayBuffer"               { Type::ArrayBuffer }
  | "SharedArrayBuffer"         { Type::SharedArrayBuffer }
  | "DataView"                  { Type::DataView }
  | "Int8Array"                 { Type::Int8Array }
  | "Int16Array"                { Type::Int16Array }
  | "Int32Array"                { Type::Int32Array }
  | "Uint8Array"                { Type::Uint8Array }
  | "Uint16Array"               { Type::Uint16Array }
  | "Uint32Array"               { Type::Uint32Array }
  | "Uint8ClampedArray"         { Type::Uint8ClampedArray }
  | "BigInt64Array"             { Type::BigInt64Array }
  | "BigUint64Array"            { Type::BigUint64Array }
  | "Float16Array"              { Type::Float16Array }
  | "Float32Array"              { Type::Float32Array }
  | "Float64Array"              { Type::Float64Array }

null_modifier -> Bool:
  | "?"                         { true }
  |                             { false }

// Const values
const_value -> ConstValue:
  | "true"                      { ConstValue::Boolean(true) }
  | "false"                     { ConstValue::Boolean(false) }
  | INTEGER                     { ConstValue::Integer($1) }
  | FLOAT                       { ConstValue::Float($1) }
  | "Infinity"                  { ConstValue::Infinity }
  | "-Infinity"                 { ConstValue::NegInfinity }
  | "NaN"                       { ConstValue::NaN }

// Default values
default_value_opt -> Option[DefaultValue]:
  | "=" default_value           { Some($2) }
  |                             { None }

default_value -> DefaultValue:
  | const_value                 { DefaultValue::ConstValue($1) }
  | STRING                      { DefaultValue::String($1) }
  | "[" "]"                     { DefaultValue::EmptySequence }
  | "{" "}"                     { DefaultValue::EmptyObject }
  | "null"                      { DefaultValue::Null }
  | "undefined"                 { DefaultValue::Undefined }

// Extended attributes
extended_attribute_list -> Array[ExtendedAttribute]:
  | "[" extended_attribute extended_attributes "]"  { [$2, ..$3] }
  |                             { [] }

extended_attributes -> Array[ExtendedAttribute]:
  | "," extended_attribute extended_attributes  { [$2, ..$3] }
  |                             { [] }

extended_attribute -> ExtendedAttribute:
  | IDENTIFIER "=" IDENTIFIER "(" argument_list ")" { ExtendedAttribute::NamedArgList($1, $3, $5) }
  | IDENTIFIER "=" IDENTIFIER   { ExtendedAttribute::Ident($1, $3) }
  | IDENTIFIER "=" STRING       { ExtendedAttribute::Ident($1, $3) }
  | IDENTIFIER "=" "*"          { ExtendedAttribute::Wildcard($1) }
  | IDENTIFIER "(" argument_list ")"  { ExtendedAttribute::ArgList($1, $3) }
  | IDENTIFIER                  { ExtendedAttribute::NoArgs($1) }

%{

// Helper functions

fn add_definition_ext_attrs(d : Definition, extended_attributes : Array[ExtendedAttribute]) -> Definition {
  guard extended_attributes.length() > 0 else {
    return d
  }
  match d {
    Definition::Interface(i) => Definition::Interface({ ..i, extended_attributes })
    Definition::PartialInterface(pi) => Definition::PartialInterface({ ..pi, extended_attributes })
    Definition::Mixin(m) => Definition::Mixin({ ..m, extended_attributes })
    Definition::PartialMixin(pm) => Definition::PartialMixin({ ..pm, extended_attributes })
    Definition::Namespace(n) => Definition::Namespace({ ..n, extended_attributes })
    Definition::PartialNamespace(pn) => Definition::PartialNamespace({ ..pn, extended_attributes })
    Definition::Dictionary(di) => Definition::Dictionary({ ..di, extended_attributes })
    Definition::PartialDictionary(pdi) => Definition::PartialDictionary({ ..pdi, extended_attributes })
    Definition::Enum(e) => Definition::Enum({ ..e, extended_attributes })
    Definition::Typedef(t) => Definition::Typedef({ ..t, extended_attributes })
    Definition::CallbackFunction(c) => Definition::CallbackFunction({ ..c, extended_attributes })
    Definition::CallbackInterface(ci) => Definition::CallbackInterface({ ..ci, extended_attributes })
    def => def
  }
}

fn add_interface_member_ext_attrs(m : InterfaceMember, attrs : Array[ExtendedAttribute]) -> InterfaceMember {
  guard attrs.length() > 0 else {
    return m
  }
  match m {
    InterfaceMember::Const(c) => InterfaceMember::Const({ ..c, extended_attributes: attrs })
    InterfaceMember::Attribute(a) => InterfaceMember::Attribute({ ..a, extended_attributes: attrs })
    InterfaceMember::Operation(o) => InterfaceMember::Operation({ ..o, extended_attributes: attrs })
    InterfaceMember::Constructor(c) => InterfaceMember::Constructor({ ..c, extended_attributes: attrs })
    InterfaceMember::Iterable(i) => InterfaceMember::Iterable({ ..i, extended_attributes: attrs })
    InterfaceMember::AsyncIterable(a) => InterfaceMember::AsyncIterable({ ..a, extended_attributes: attrs })
    InterfaceMember::Maplike(ml) => InterfaceMember::Maplike({ ..ml, extended_attributes: attrs })
    InterfaceMember::Setlike(s) => InterfaceMember::Setlike({ ..s, extended_attributes: attrs })
    InterfaceMember::Stringifier(s) => InterfaceMember::Stringifier(s)
  }
}

fn add_callback_interface_member_ext_attrs(m : CallbackInterfaceMember, attrs : Array[ExtendedAttribute]) -> CallbackInterfaceMember {
  guard attrs.length() > 0 else {
    return m
  }
  match m {
    CallbackInterfaceMember::Operation(o) => CallbackInterfaceMember::Operation({ ..o, extended_attributes: attrs })
    CallbackInterfaceMember::Const(c) => CallbackInterfaceMember::Const({ ..c, extended_attributes: attrs })
  }
}

fn add_namespace_member_ext_attrs(m : NamespaceMember, attrs : Array[ExtendedAttribute]) -> NamespaceMember {
  guard attrs.length() > 0 else {
    return m
  }
  match m {
    NamespaceMember::Attribute(a) => NamespaceMember::Attribute({ ..a, extended_attributes: attrs })
    NamespaceMember::Operation(o) => NamespaceMember::Operation({ ..o, extended_attributes: attrs })
    NamespaceMember::Const(c) => NamespaceMember::Const({ ..c, extended_attributes: attrs })
  }
}

fn type_to_string_type(t : Type) -> StringType {
  match t {
    Type::DOMString => StringType::DOMString
    Type::ByteString => StringType::ByteString
    Type::USVString => StringType::USVString
    _ => StringType::DOMString
  }
}

%}