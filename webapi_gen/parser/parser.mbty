// WebIDL Parser Grammar - Extended
// Based on the WebIDL grammar: https://webidl.spec.whatwg.org/#idl-grammar

%derive<Show,ToJson> Token
%derive<Show> ParseError
%position<Position>
%start definitions

// Token declarations
%token EOF
%token<String> INTEGER
%token<String> FLOAT
%token<String> STRING
%token<String> IDENTIFIER

// Keywords - Definition
%token INTERFACE      "interface"
%token PARTIAL        "partial"
%token MIXIN          "mixin"
%token DICTIONARY     "dictionary"
%token ENUM           "enum"
%token TYPEDEF        "typedef"
%token CALLBACK       "callback"
%token NAMESPACE      "namespace"
%token INCLUDES       "includes"

// Keywords - Member
%token ATTRIBUTE      "attribute"
%token CONST          "const"
%token READONLY       "readonly"
%token INHERIT        "inherit"
%token STATIC         "static"
%token STRINGIFIER    "stringifier"
%token GETTER         "getter"
%token SETTER         "setter"
%token DELETER        "deleter"
%token CONSTRUCTOR    "constructor"
%token ITERABLE       "iterable"
%token ASYNC_ITERABLE "async_iterable"
%token ASYNC_SEQUENCE  "async_sequence"
%token MAPLIKE        "maplike"
%token SETLIKE        "setlike"
%token REQUIRED       "required"
%token OPTIONAL       "optional"

// Type keywords - Primitive
%token UNDEFINED      "undefined"
%token BOOLEAN        "boolean"
%token BYTE           "byte"
%token OCTET          "octet"
%token SHORT          "short"
%token LONG           "long"
%token UNSIGNED       "unsigned"
%token FLOAT_KW       "float"
%token DOUBLE         "double"
%token UNRESTRICTED   "unrestricted"
%token BIGINT         "bigint"

// Type keywords - String types
%token DOMSTRING      "DOMString"
%token BYTESTRING     "ByteString"
%token USVSTRING      "USVString"

// Type keywords - Special
%token ANY            "any"
%token OBJECT         "object"
%token SYMBOL         "symbol"

// Type keywords - Parameterized
%token SEQUENCE       "sequence"
%token PROMISE        "Promise"
%token FROZENARRAY    "FrozenArray"
%token OBSERVABLEARRAY "ObservableArray"
%token RECORD         "record"

// Operators
%token OR             "or"

// Type keywords - Buffer types
%token ARRAYBUFFER         "ArrayBuffer"
%token SHAREDARRAYBUFFER   "SharedArrayBuffer"
%token DATAVIEW            "DataView"
%token INT8ARRAY           "Int8Array"
%token INT16ARRAY          "Int16Array"
%token INT32ARRAY          "Int32Array"
%token UINT8ARRAY          "Uint8Array"
%token UINT16ARRAY         "Uint16Array"
%token UINT32ARRAY         "Uint32Array"
%token UINT8CLAMPEDARRAY   "Uint8ClampedArray"
%token BIGINT64ARRAY       "BigInt64Array"
%token BIGUINT64ARRAY      "BigUint64Array"
%token FLOAT16ARRAY        "Float16Array"
%token FLOAT32ARRAY        "Float32Array"
%token FLOAT64ARRAY        "Float64Array"

// Literal keywords
%token TRUE           "true"
%token FALSE          "false"
%token NULL           "null"
%token INFINITY       "Infinity"
%token NEG_INFINITY   "-Infinity"
%token NAN            "NaN"

// Symbols
%token LBRACE         "{"
%token RBRACE         "}"
%token LPAREN         "("
%token RPAREN         ")"
%token LBRACKET       "["
%token RBRACKET       "]"
%token LANGLE         "<"
%token RANGLE         ">"
%token COMMA          ","
%token SEMICOLON      ";"
%token COLON          ":"
%token EQUALS         "="
%token QUESTION       "?"
%token ELLIPSIS       "..."
%token STAR           "*"

%%

definitions -> Array[DefinitionExtendedAttributes]:
  | extended_attributes = extended_attribute_list definition=definition defs=definitions  
    { [{extended_attributes, definition, spec: None}, ..defs] }
  | EOF { [] }

definition -> Definition:
  | i=interface_def               { Definition::Interface(i) }
  | m=mixin_def                   { Definition::Mixin(m) }
  | p=partial_interface_def       { Definition::PartialInterface(p) }
  | p=partial_mixin_def           { Definition::PartialMixin(p) }
  | n=namespace_def               { Definition::Namespace(n) }
  | p=partial_namespace_def       { Definition::PartialNamespace(p) }
  | d=dictionary_def              { Definition::Dictionary(d) }
  | p=partial_dictionary_def      { Definition::PartialDictionary(p) }
  | e=enum_def                    { Definition::Enum(e) }
  | t=typedef_def                 { Definition::Typedef(t) }
  | c=callback_def                { Definition::CallbackFunction(c) }
  | ci=callback_interface_def     { Definition::CallbackInterface(ci) }
  | inc=includes_statement        { Definition::Includes(inc) }

// Interface definitions
interface_def -> InterfaceDefinition:
  | "interface" name=IDENTIFIER inheritance=inheritance "{" members=interface_members "}" ";" { { name, inheritance, members } }

partial_interface_def -> PartialInterfaceDefinition:
  | "partial" "interface" name=IDENTIFIER "{" members=interface_members "}" ";"  { { name, members } }

mixin_def -> MixinDefinition:
  | "interface" "mixin" name=IDENTIFIER "{" members=interface_members "}" ";" { { name, members } }

partial_mixin_def -> PartialMixinDefinition:
  | "partial" "interface" "mixin" name=IDENTIFIER "{" members=interface_members "}" ";" { { name, members } }

namespace_def -> NamespaceDefinition:
  | "namespace" name=IDENTIFIER "{" members=namespace_members "}" ";" { { name, members } }

partial_namespace_def -> PartialNamespaceDefinition:
  | "partial" "namespace" name=IDENTIFIER "{" members=namespace_members "}" ";" { { name, members } }

dictionary_def -> DictionaryDefinition:
  | "dictionary" name=IDENTIFIER inheritance=inheritance "{" members=dictionary_members "}" ";" { { name, inheritance, members } }

partial_dictionary_def -> PartialDictionaryDefinition:
  | "partial" "dictionary" name=IDENTIFIER "{" members=dictionary_members "}" ";" { { name, members } }

enum_def -> EnumDefinition:
  | "enum" name=IDENTIFIER "{" values=enum_value_list "}" ";" { { name, values } }
      
typedef_def -> TypedefDefinition:
  | "typedef" type_=type name=IDENTIFIER ";" { { type_, name } }

callback_def -> CallbackFunctionDefinition:
  | "callback" name=IDENTIFIER "=" return_type=type "(" arguments=argument_list ")" ";" 
      { { name, return_type, arguments, spec: None } }

callback_interface_def -> CallbackInterfaceDefinition:
  | "callback" "interface" name=IDENTIFIER "{" members = callback_interface_members "}" ";" { { name, members, spec: None } }

includes_statement -> IncludesStatement:
  | interface_name=IDENTIFIER "includes" mixin_name=IDENTIFIER ";" { { interface_name, mixin_name } }

inheritance -> String?:
  | ":" name=IDENTIFIER         { Some(name) }
  |                             { None }

// Callback interface members
callback_interface_members -> Array[CallbackInterfaceMemberExtendedAttributes]:
  | extended_attributes=extended_attribute_list m=callback_interface_member members=callback_interface_members
      { [ { extended_attributes, callback_interface_member: m }, ..members] }
  |   { [] }

callback_interface_member -> CallbackInterfaceMember:
  | op=regular_operation_member   { CallbackInterfaceMember::Operation(op) }
  | c=const_member                { CallbackInterfaceMember::Const(c) }

// Interface members
interface_members -> Array[InterfaceMemberExtendedAttributes]:
  | extended_attributes=extended_attribute_list interface_member=interface_member members=interface_members
      { [ {extended_attributes, interface_member }, ..members] }
  |   { [] }

interface_member -> InterfaceMember:
  | c=const_member                { Const(c) }  
  | "constructor" "(" arguments=argument_list ")" ";" { Constructor({ arguments, }) }
  | "stringifier" ";"             { Stringifier(StringifierMember::Bare) }  
  | "stringifier" "readonly" "attribute" type_=type_with_extended_attributes name=attribute_name ";"
      { Attribute({ type_: type_.type_, name, is_readonly: true, static_: false, is_inherit: false }) }
  | "stringifier" "attribute" type_=type_with_extended_attributes name=attribute_name ";"
      { Attribute({ type_: type_.type_, name, is_readonly: false, static_: false, is_inherit: false }) }
  | "static" "readonly" "attribute" type_=type_with_extended_attributes name=attribute_name ";"
      { Attribute({ type_: type_.type_, name, is_readonly: true, static_: true, is_inherit: false }) }
  | "static" "attribute" type_=type_with_extended_attributes name=attribute_name ";"
      { Attribute({ type_: type_.type_, name, is_readonly: false, static_: true, is_inherit: false }) }
  | i=iterable_member             { Iterable(i) }
  | "async_iterable" "<" type ">" ";"
      { AsyncIterable({ key_type: None, value_type: $3, arguments: [] }) }
  | "async_iterable" "<" type "," type ">" ";"
      { AsyncIterable({ key_type: Some($3), value_type: $5, arguments: [] }) }
  | "readonly" m=maplike_member   { Maplike({ ..m, is_readonly: true }) }
  | m=maplike_member              { Maplike(m) }
  | "readonly" s=setlike_member   { Setlike({ ..s, is_readonly: true }) }
  | s=setlike_member              { Setlike(s) }
  | "inherit" "readonly" "attribute" type_=type_with_extended_attributes name=attribute_name ";"
      { Attribute({ type_: type_.type_, name, is_readonly: true, static_: false, is_inherit: true }) }
  | "inherit" "attribute" type_=type_with_extended_attributes name=attribute_name ";"
      { Attribute({ type_: type_.type_, name, is_readonly: false, static_: false, is_inherit: true }) }
  | "readonly" "attribute" type_=type_with_extended_attributes name=attribute_name ";"
      { Attribute({ type_: type_.type_, name, is_readonly: true, static_: false, is_inherit: false }) }
  | "attribute" type_=type_with_extended_attributes name=attribute_name ";"
      { Attribute({ type_: type_.type_, name, is_readonly: false, static_: false, is_inherit: false }) }
  | special=special return_type=type name=operation_name "(" arguments=argument_list ")" ";"
      { SpecialOperation({ return_type, name, arguments, special }) }
  | "static" op=regular_operation_member  { RegularOperation({ ..op, static_: true }) }
  | op=regular_operation_member           { RegularOperation(op) }

regular_operation_member -> RegularOperationMember:
  | return_type=type name=IDENTIFIER "(" arguments=argument_list ")" ";"
      { { return_type, name: name.trim(chars="_").to_string(), arguments, static_: false } }

const_member -> ConstMember:
  | "const" type_=type name=IDENTIFIER "=" value=const_value ";" { { type_, name, value } }

operation_name -> String?:
  | name=IDENTIFIER           { Some(name) }
  |                           { None }

special -> Special:
  | "getter"                    { Special::Getter }
  | "setter"                    { Special::Setter }
  | "deleter"                   { Special::Deleter }

iterable_member -> IterableMember:
  | "iterable" "<" value_type=type ">" ";" { { key_type: None, value_type } }
  | "iterable" "<" key_type=type "," value_type=type ">" ";" { { key_type: Some(key_type), value_type } }

maplike_member -> MaplikeMember:
  | "maplike" "<" key_type=type "," value_type=type ">" ";" { { key_type, value_type, is_readonly: false } }

setlike_member -> SetlikeMember:
  | "setlike" "<" value_type=type ">" ";" { { value_type, is_readonly: false } }

// Namespace members
namespace_members -> Array[NamespaceMemberExtendedAttributes]:
  | extended_attributes=extended_attribute_list namespace_member = namespace_member namespaces=namespace_members 
    { [{ extended_attributes, namespace_member}, ..namespaces] }
  |                             { [] }

namespace_member -> NamespaceMember:
  | "readonly" "attribute" type_=type name=IDENTIFIER ";" 
    { Attribute({ type_, name, is_readonly: true, static_: false, is_inherit: false }) }
  | op=regular_operation_member { Operation(op) }
  | const_member                { Const($1) }

// Dictionary members
dictionary_members -> Array[DictionaryMember]:
  | extended_attributes=extended_attribute_list m=dictionary_member members=dictionary_members
      { [{ ..m, extended_attributes }, ..members] }
  |                             { [] }

dictionary_member -> DictionaryMember:
  | "required" type_=type name=IDENTIFIER ";"
      { { extended_attributes: [], type_, name, required: true, default_value: None } }
  | type_=type name=IDENTIFIER default_value=default_value_opt ";"
      { { extended_attributes: [], type_, name, required: false, default_value } }

// Enum values
enum_value_list -> Array[String]:
  | e=STRING enums=enum_value_list_rest { [e, ..enums] }

enum_value_list_rest -> Array[String]:
  | "," e=STRING enums=enum_value_list_rest  { [e, ..enums] }
  | ","                              { [] }
  |                                  { [] }

// Arguments
argument_list -> Array[Argument]:
  | arg=argument arguments=arguments  { [arg, ..arguments] }
  |                                   { [] }

arguments -> Array[Argument]:
  | "," arg=argument arguments=arguments  { [arg, ..arguments] }
  |                             { [] }

argument -> Argument:
  | extended_attributes=extended_attribute_list arg=argument_rest
      { { ..arg, extended_attributes } }

argument_rest -> Argument:
  | "optional" type_=type_with_extended_attributes name=argument_name default_value=default_value_opt
      { { extended_attributes:[], type_, name, optional: true, variadic: false, default_value } }
  | type_=type variadic=ellipsis  name=argument_name
      { 
        let type_ = { extended_attributes: [], type_ }
        { extended_attributes:[], type_, name, optional: false, variadic, default_value: None } 
      }

ellipsis -> Bool:
  | "..."                       { true }
  |                             { false }

attribute_name -> String:
  | name=argument_name_keyword   { name }
  | name=IDENTIFIER              { name }

argument_name -> String:
  | name=argument_name_keyword   { name }
  | name=IDENTIFIER              { name }

argument_name_keyword -> String
  : "attribute"    { "attribute" }
  | "callback"     { "callback" }
  | "const"        { "const" }
  | "constructor"  { "constructor" }
  | "deleter"      { "deleter" }
  | "dictionary"   { "dictionary" }
  | "enum"         { "enum" }
  | "getter"       { "getter" }
  | "includes"     { "includes" }
  | "inherit"      { "inherit" }
  | "interface"    { "interface" }
  | "iterable"     { "iterable" }
  | "maplike"      { "maplike" }
  | "mixin"        { "mixin" }
  | "namespace"    { "namespace" }
  | "partial"      { "partial" }
  | "readonly"     { "readonly" }
  | "required"     { "required" }
  | "setlike"      { "setlike" }
  | "setter"       { "setter" }
  | "static"       { "static" }
  | "stringifier"  { "stringifier" }
  | "typedef"      { "typedef" }
  | "unrestricted" { "unrestricted" }
  ;

type -> Type:
  | type_=single_type { type_ }
  | union_type=union_type "?" { Type::Nullable(union_type) }
  | union_type=union_type { union_type }

type_with_extended_attributes -> TypeWithExtendedAttributes:
  | extended_attributes=extended_attribute_list type_=type  { { extended_attributes, type_ } }

// Union types
union_type -> Type:
  | "(" union_member_type "or" union_member_type union_member_types ")"      { Type::Union([$2, $4, ..$5]) }

union_member_type -> TypeWithExtendedAttributes:
  | extended_attributes = extended_attribute_list type_=distinguishable_type
    { {extended_attributes, type_} }
  | union_type=union_type is_null=null_modifier
    {
      let ty = match is_null {
        true => Type::Nullable(union_type)
        false => union_type
      }
      { extended_attributes: [], type_: ty }
    }

union_member_types -> Array[TypeWithExtendedAttributes]:
  | "or" union_member_type union_member_types   { [$2, ..$3] }
  |                                             { [] }

distinguishable_type -> Type:
  | p=primitive_type              { p }
  | st=string_type                { st }
  | id=IDENTIFIER                 { Type::Identifier(id) }
  | "sequence" "<" t=type ">"       { Type::Sequence(t) }
  | "async_sequence" "<" type_=type_with_extended_attributes ">" { Type::AsyncSequence(type_) }
  | "object"                    { Type::Object }
  | "symbol"                    { Type::Symbol }
  | bt=buffer_type                 { bt }
  | "FrozenArray" "<" t=type_with_extended_attributes ">" { Type::FrozenArray(t) }
  | "ObservableArray" "<" t=type_with_extended_attributes ">" { Type::ObservableArray(t) }
  | "record" "<" st=string_type "," t=type_with_extended_attributes ">" { Type::Record(type_to_string_type(st), t) }
  | "undefined"                 { Type::Undefined }

single_type -> Type:
  | type_=distinguishable_type is_null=null_modifier
    { 
      if is_null {
        Type::Nullable(type_)
      } else {
        type_
      }
    }
  | "any"                       { Type::Any }
  | "Promise" "<" type ">"      { Type::Promise($3) }

primitive_type -> Type:
  // Unsigned integer types
  | "unsigned" "short"          { Type::UnsignedShort }
  | "unsigned" "long" "long"    { Type::UnsignedLongLong }
  | "unsigned" "long"           { Type::UnsignedLong }
  
  // Signed integer types
  | "short"                     { Type::Short }  
  | "long"                      { Type::Long }
  | "long" "long"               { Type::LongLong }  
  
  // Unrestricted float types
  | "unrestricted" "float"      { Type::UnrestrictedFloat }
  | "unrestricted" "double"     { Type::UnrestrictedDouble }
  
  // Float types
  | "float"                     { Type::Float }  
  | "double"                    { Type::Double }

  // Other primitive types
  | "boolean"                   { Type::Boolean }
  | "byte"                      { Type::Byte }
  | "octet"                     { Type::Octet }
  | "bigint"                    { Type::Bigint }

string_type -> Type:
  | "DOMString"                 { Type::DOMString }
  | "ByteString"                { Type::ByteString }
  | "USVString"                 { Type::USVString }

buffer_type -> Type:
  | "ArrayBuffer"               { Type::ArrayBuffer }
  | "SharedArrayBuffer"         { Type::SharedArrayBuffer }
  | "DataView"                  { Type::DataView }
  | "Int8Array"                 { Type::Int8Array }
  | "Int16Array"                { Type::Int16Array }
  | "Int32Array"                { Type::Int32Array }
  | "Uint8Array"                { Type::Uint8Array }
  | "Uint16Array"               { Type::Uint16Array }
  | "Uint32Array"               { Type::Uint32Array }
  | "Uint8ClampedArray"         { Type::Uint8ClampedArray }
  | "BigInt64Array"             { Type::BigInt64Array }
  | "BigUint64Array"            { Type::BigUint64Array }
  | "Float16Array"              { Type::Float16Array }
  | "Float32Array"              { Type::Float32Array }
  | "Float64Array"              { Type::Float64Array }

null_modifier -> Bool:
  | "?"                         { true }
  |                             { false }

// Const values
const_value -> Const:
  | b=boolean_literal           { Const::Boolean(b) }
  | f=float_literal             { Const::Float(f) }
  | i=INTEGER                   { Const::Integer(i) }  

boolean_literal -> String:
  | "true"                      { "true" }
  | "false"                     { "false" }

float_literal -> FloatLiteral:
  | f=FLOAT                     { FloatLiteral::Float(f) }
  | "Infinity"                  { FloatLiteral::Infinity }
  | "-Infinity"                 { FloatLiteral::NegInfinity }
  | "NaN"                       { FloatLiteral::NaN }

// Default values
default_value_opt -> Option[DefaultValue]:
  | "=" default_value           { Some($2) }
  |                             { None }

default_value -> DefaultValue:
  | const_value                 { DefaultValue::ConstValue($1) }
  | STRING                      { DefaultValue::String($1) }
  | "[" "]"                     { DefaultValue::EmptySequence }
  | "{" "}"                     { DefaultValue::EmptyObject }
  | "null"                      { DefaultValue::Null }
  | "undefined"                 { DefaultValue::Undefined }

// Extended attributes
extended_attribute_list -> Array[ExtendedAttribute]:
  | "[" ext_attr=extended_attribute attrs=extended_attributes "]"  { [ext_attr, ..attrs] }
  |                             { [] }

extended_attributes -> Array[ExtendedAttribute]:
  | "," ext_attr=extended_attribute attrs=extended_attributes  { [ext_attr, ..attrs] }
  |                             { [] }

extended_attribute -> ExtendedAttribute:
  | arg_name=IDENTIFIER "=" arg_value=IDENTIFIER "(" args=argument_list ")" { ExtendedAttribute::NamedArgList(arg_name, arg_value, args) }
  | attr_name=IDENTIFIER "=" "(" i1=INTEGER "," i2=INTEGER ")" { ExtendedAttribute::IntPair(attr_name, i1, i2) }
  | attr_name=IDENTIFIER "=" "(" idents=identifier_list ")" { ExtendedAttribute::IdentList(attr_name, idents) }
  | attr_name=IDENTIFIER "=" attr_value=IDENTIFIER { ExtendedAttribute::Ident(attr_name, attr_value) }
  | attr_name=IDENTIFIER "=" int_val=INTEGER { ExtendedAttribute::IntValue(attr_name, int_val) }
  | attr_name=IDENTIFIER "=" float_val=FLOAT { ExtendedAttribute::FloatValue(attr_name, float_val) }
  | attr_name=IDENTIFIER "=" STRING             { ExtendedAttribute::Ident(attr_name, $3) }
  | id=IDENTIFIER "=" "*"                       { ExtendedAttribute::Wildcard(id) }
  | name=IDENTIFIER "(" args=argument_list ")"  { ExtendedAttribute::ArgList(name, args) }
  | name=IDENTIFIER                             { ExtendedAttribute::NoArgs(name) }

identifier_list -> Array[String]:
  | id=IDENTIFIER rest=identifier_list_rest { [id, ..rest] }

identifier_list_rest -> Array[String]:
  | "," id=IDENTIFIER rest=identifier_list_rest { [id, ..rest] }
  |                                             { [] }

%{

// Helper functions

fn type_to_string_type(t : Type) -> StringType {
  match t {
    Type::DOMString => StringType::DOMString
    Type::ByteString => StringType::ByteString
    Type::USVString => StringType::USVString
    _ => StringType::DOMString
  }
}

%}