  serialize_to_string(Self, &TNode) -> String
}

pub trait TXPathEvaluator : TJsValue {
  create_expression(Self, String, resolver? : XPathNSResolver) -> XPathExpression
  create_ns_resolver(Self, &TNode) -> Node
  evaluate(Self, String, &TNode, resolver? : XPathNSResolver, type_? : UInt, result? : &TXPathResult) -> XPathResult
}

pub trait TXPathExpression : TJsValue {
  evaluate(Self, &TNode, type_? : UInt, result? : &TXPathResult) -> XPathResult
}

pub trait TXPathResult : TJsValue {
  result_type(Self) -> UInt
  number_value(Self) -> Double
  string_value(Self) -> String
  boolean_value(Self) -> Bool
  single_node_value(Self) -> Node
  invalid_iterator_state(Self) -> Bool
  snapshot_length(Self) -> UInt
  iterate_next(Self) -> Node?
  snapshot_item(Self, UInt) -> Node?
}

pub trait TXSLTProcessor : TJsValue {
  import_stylesheet(Self, &TNode) -> Unit
  transform_to_fragment(Self, &TNode, &TDocument) -> DocumentFragment
  transform_to_document(Self, &TNode) -> Document
  set_parameter(Self, String, String, JsValue) -> Unit
  get_parameter(Self, String, String) -> JsValue
  remove_parameter(Self, String, String) -> Unit
  clear_parameters(Self) -> Unit
  reset(Self) -> Unit
}

