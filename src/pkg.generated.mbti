// Type aliases

// Traits
pub trait TAbortController : TJsValue {
  signal(Self) -> AbortSignal
  abort(Self, reason? : JsValue) -> Unit
}

pub trait TAbortSignal : TJsValue + TEventTarget {
  aborted(Self) -> Bool
  reason(Self) -> JsValue
  onabort(Self) -> EventHandler
  set_onabort(Self, EventHandler) -> Unit
  throw_if_aborted(Self) -> Unit
}

pub(open) trait TAddEventListenerOptionsArg {
  to_js(Self) -> JsValue
}
pub impl TAddEventListenerOptionsArg for Bool

pub(open) trait TAfterNodesArg {
  to_js(Self) -> JsValue
}
pub impl TAfterNodesArg for String

pub(open) trait TAppendNodesArg {
  to_js(Self) -> JsValue
}
pub impl TAppendNodesArg for String

pub(open) trait TAssignNodesArg {
  to_js(Self) -> JsValue
}

pub trait TAttr : TJsValue + TNode {
  namespace_uri(Self) -> String?
  prefix(Self) -> String?
  local_name(Self) -> String
  name(Self) -> String
  value(Self) -> String
  set_value(Self, String) -> Unit
  owner_element(Self) -> Element?
  specified(Self) -> Bool
}

pub(open) trait TBeforeNodesArg {
  to_js(Self) -> JsValue
}
pub impl TBeforeNodesArg for String

pub trait TBlob : TJsValue {
  size(Self) -> UInt64
  type_(Self) -> String
  slice(Self, start? : Int64, end? : Int64, content_type? : String) -> Blob
  stream(Self) -> JsValue
  text(Self) -> JsPromise[String]
  array_buffer(Self) -> JsPromise[ArrayBuffer]
  bytes(Self) -> JsPromise[Uint8Array]
}

pub trait TCDATASection : TJsValue + TText {
}

pub(open) trait TCanvas {
  to_js(Self) -> JsValue
}

pub trait TCanvasGradient : TJsValue {
  add_color_stop(Self, Double, String) -> Unit
}

pub(open) trait TCanvasImageSource {
  to_js(Self) -> JsValue
}
pub fn[T : TCanvasImageSource] &TCanvasImageSource::into(Self) -> T

pub trait TCanvasPattern : TJsValue {
  set_transform(Self, transform? : DOMMatrix2DInit) -> Unit
}

pub trait TCanvasRenderingContext2D : TJsValue {
  canvas(Self) -> HTMLCanvasElement
  global_alpha(Self) -> Double
  set_global_alpha(Self, Double) -> Unit
  global_composite_operation(Self) -> String
  set_global_composite_operation(Self, String) -> Unit
  image_smoothing_enabled(Self) -> Bool
  set_image_smoothing_enabled(Self, Bool) -> Unit
  image_smoothing_quality(Self) -> ImageSmoothingQuality
  set_image_smoothing_quality(Self, ImageSmoothingQuality) -> Unit
  stroke_style(Self) -> StrokeStyle
  set_stroke_style(Self, &TStrokeStyle) -> Unit
  fill_style(Self) -> FillStyle
  set_fill_style(Self, &TFillStyle) -> Unit
  shadow_offset_x(Self) -> Double
  set_shadow_offset_x(Self, Double) -> Unit
  shadow_offset_y(Self) -> Double
  set_shadow_offset_y(Self, Double) -> Unit
  shadow_blur(Self) -> Double
  set_shadow_blur(Self, Double) -> Unit
  shadow_color(Self) -> String
  set_shadow_color(Self, String) -> Unit
  filter(Self) -> String
  set_filter(Self, String) -> Unit
  line_width(Self) -> Double
  set_line_width(Self, Double) -> Unit
  line_cap(Self) -> CanvasLineCap
  set_line_cap(Self, CanvasLineCap) -> Unit
  line_join(Self) -> CanvasLineJoin
  set_line_join(Self, CanvasLineJoin) -> Unit
  miter_limit(Self) -> Double
  set_miter_limit(Self, Double) -> Unit
  line_dash_offset(Self) -> Double
  set_line_dash_offset(Self, Double) -> Unit
  lang(Self) -> String
  set_lang(Self, String) -> Unit
  font(Self) -> String
  set_font(Self, String) -> Unit
  text_align(Self) -> CanvasTextAlign
  set_text_align(Self, CanvasTextAlign) -> Unit
  text_baseline(Self) -> CanvasTextBaseline
  set_text_baseline(Self, CanvasTextBaseline) -> Unit
  direction(Self) -> CanvasDirection
  set_direction(Self, CanvasDirection) -> Unit
  letter_spacing(Self) -> String
