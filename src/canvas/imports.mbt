///|
/// Import types, traits, and functions from dependency packages.
/// This eliminates the need for @pkg. prefixes.

///|
using @core {
  type JsValue,
  type JsArray,
  type JsPromise,
  type Blob,
  type BlobPropertyBag,
  type EndingType,
  type ArrayBuffer,
  type DataView,
  type Int8Array,
  type Int16Array,
  type Int32Array,
  type Uint8Array,
  type Uint8ClampedArray,
  type Uint16Array,
  type Uint32Array,
  type BigInt64Array,
  type BigUint64Array,
  type Float32Array,
  type Float64Array,
  type Storage,
  trait TJsValue,
  trait TBlob,
  trait TStorage,
  opt_to_js,
  fn_to_js,
  default_js_value,
}

///|
using @dom {
  type EventTarget,
  type Event,
  type CustomEvent,
  type Node,
  type Element,
  type Document,
  type DocumentFragment,
  type Attr,
  type CharacterData,
  type Text,
  type Comment,
  type ShadowRoot,
  type NodeList,
  type HTMLCollection,
  type NamedNodeMap,
  type DOMTokenList,
  type Range,
  type MutationObserver,
  type MutationRecord,
  type Window,
  type Navigator,
  type Location,
  type History,
  type UIEvent,
  type MouseEvent,
  type KeyboardEvent,
  type FocusEvent,
  type InputEvent,
  type WheelEvent,
  type PointerEvent,
  type TouchEvent,
  type EventListener,
  trait TEventTarget,
  trait TEvent,
  trait TNode,
  trait TElement,
  trait TDocument,
  trait TCharacterData,
  document,
  window,
  event_listener,
}
